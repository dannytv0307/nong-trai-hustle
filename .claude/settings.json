{
  "permissions": {
    "allow": [
      "Bash(.venv/Scripts/python tools/*)",
      "Bash(./.venv/Scripts/python tools/*)",
      "PowerShell(.venv\\Scripts\\python tools\\*)",
      "PowerShell(.\\.venv\\Scripts\\python tools\\*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(npm run *)",
      "Bash(npm test*)",
      "Bash(npx tsc*)",
      "Bash(npx vitest*)",
      "Bash(npx playwright test*)",
      "Bash(npx prisma generate*)",
      "Bash(docker compose ps*)",
      "Bash(docker compose logs*)",
      "Bash(docker info*)"
    ],
    "deny": [
      "Bash(git push*)",
      "Read(./**/*.keystore)",
      "Read(./**/*.jks)",
      "Read(./**/.env)",
      "Read(./**/.env.local)",
      "Read(./**/.env.production)",
      "Bash(gcloud run deploy*)",
      "Bash(gcloud sql instances create*)"
    ]
  }
}
