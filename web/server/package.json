{
  "name": "@bph/server",
  "version": "0.1.0",
  "private": true,
  "description": "Server tài khoản + cloud save của Bride Price Hustle",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "npm run build -w @bph/shared && tsx watch src/server.ts",
    "build": "npm run build -w @bph/shared && prisma generate && tsc -b",
    "start": "node dist/server.js",
    "test": "npm run build -w @bph/shared && vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@bph/shared": "*",
    "@fastify/cookie": "^11.1.3",
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.1.2",
    "@fastify/rate-limit": "^11.2.1",
    "@prisma/adapter-pg": "~7.10.0",
    "@prisma/client": "~7.10.0",
    "dotenv": "^18.0.6",
    "fastify": "^5.12.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24",
    "prisma": "~7.10.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  }
}
