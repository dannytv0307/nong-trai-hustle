# Sao chép file này thành .env (cùng thư mục) rồi điền giá trị. KHÔNG commit .env.
# Môi trường: development | test | production
NODE_ENV=development
HOST=localhost
PORT=3000
# Mức log: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Postgres local (khớp web/docker-compose.yml). Production: Cloud SQL, lấy từ Secret Manager.
DATABASE_URL=postgresql://bph:<mat-khau-dev>@localhost:5432/bph?schema=public

# Origin của client (Vite dev). Nhiều origin cách nhau bằng dấu phẩy.
CLIENT_ORIGIN=http://localhost:5173

# Chuỗi ngẫu nhiên >= 32 ký tự (ký cookie). Tạo bằng:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# --- OAuth (bước 3.4, chưa dùng) ---
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# FACEBOOK_CLIENT_ID=
# FACEBOOK_CLIENT_SECRET=
# PUBLIC_BASE_URL=http://localhost:3000
