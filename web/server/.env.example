# Sao chép file này thành .env (cùng thư mục) rồi điền giá trị. KHÔNG commit .env.
# start.bat / npm run up tự tạo .env từ file này (SESSION_SECRET ngẫu nhiên) nếu chưa có.
# Môi trường: development | test | production
NODE_ENV=development
HOST=localhost
PORT=3000
# Mức log: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Postgres local khi chạy server/test NGOÀI Docker (cổng = POSTGRES_PORT trong web/.env, mặc định 5433).
# Trong Docker, docker-compose.yml tự đặt DATABASE_URL trỏ db:5432 (ưu tiên hơn dòng này). Production: Cloud SQL + Secret Manager.
DATABASE_URL=postgresql://bph:bph_dev_only@localhost:5433/bph?schema=public

# Origin của client (Vite dev). Nhiều origin cách nhau bằng dấu phẩy.
CLIENT_ORIGIN=http://localhost:5173

# Chuỗi ngẫu nhiên >= 32 ký tự (ký cookie). Tạo bằng:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# --- OAuth (bước 3.4, chưa dùng) ---
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# FACEBOOK_CLIENT_ID=
# FACEBOOK_CLIENT_SECRET=
# PUBLIC_BASE_URL=http://localhost:3000
