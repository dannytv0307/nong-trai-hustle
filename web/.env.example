# Cấu hình Docker dev cho máy của bạn (KHÔNG phải bí mật của server — cái đó ở server/.env).
# Muốn đổi thì sao chép file này thành web/.env (đã gitignore) rồi sửa. Không có web/.env thì dùng mặc định dưới đây.

# Cổng Postgres trên MÁY BẠN (127.0.0.1:<cổng>). Bên trong Docker, server vẫn nối db:5432 — không đổi.
# Mặc định 5433 để tránh 5432 hay bị Postgres của dự án khác chiếm. Đổi ở đây nếu 5433 cũng bận,
# và nhớ sửa cổng trong DATABASE_URL của server/.env nếu bạn chạy server/test NGOÀI Docker.
POSTGRES_PORT=5433

# Tài khoản DB dev (giá trị công khai, chỉ cho máy local). Đổi sau khi DB đã tạo thì phải xóa volume bph_bph-db-data.
# POSTGRES_USER=bph
# POSTGRES_PASSWORD=bph_dev_only
# POSTGRES_DB=bph
